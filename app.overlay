/* waveform generation-Method 1*/ 
/* app.overlay*/ 


/ { 
    bus_outputs { 
        compatible = "gpio-leds"; 

        bus_lsb: led_1 { 
            gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>; 
            label = "Bus LSB"; 
        }; 

        bus_sb2: led_2 { 
            gpios = <&gpio1 23 GPIO_ACTIVE_HIGH>; 
            label = "Bus MSB"; 
        }; 

        bus_sb3: led_3 { 
            gpios = <&gpio2 ?? GPIO_ACTIVE_HIGH>; 
            label = "Bus MSB"; 
        };

        bus_msb: led_3 { 
            gpios = <&gpio3 ?? GPIO_ACTIVE_HIGH>; 
            label = "Bus MSB"; 
        };
    }; 
}; 